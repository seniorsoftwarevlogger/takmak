if SHIELD_TAKMAK_DONGLE

config ZMK_KEYBOARD_NAME
    default "Takmak 3.0"

endif # SHIELD_TAKMAK_DONGLE


if SHIELD_TAKMAK_RIGHT

config ZMK_KEYBOARD_NAME
    default "Takmak 3.0 R"

endif # end SHIELD_TAKMAK_RIGHT


if SHIELD_TAKMAK_LEFT

config ZMK_KEYBOARD_NAME
    default "Takmak 3.0 L"

if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

if ZMK_SPLIT_ROLE_CENTRAL

choice ZMK_DISPLAY_STATUS_SCREEN
    default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
endchoice

# Monochrome portrait screen fonts and allocation headroom.
config LV_USE_THEME_MONO
    default y

config LV_FONT_UNSCII_8
    default y

choice LV_FONT_DEFAULT
    default LV_FONT_DEFAULT_UNSCII_8
endchoice

choice ZMK_LV_FONT_DEFAULT_SMALL
    default ZMK_LV_FONT_DEFAULT_SMALL_UNSCII_8
endchoice

config LV_Z_MEM_POOL_SIZE
    default 8192

endif # ZMK_SPLIT_ROLE_CENTRAL

endif # ZMK_DISPLAY

endif # end SHIELD_TAKMAK_LEFT


if SHIELD_TAKMAK_LEFT || SHIELD_TAKMAK_RIGHT || SHIELD_TAKMAK_DONGLE

config ZMK_SPLIT
    default y

endif # end both

