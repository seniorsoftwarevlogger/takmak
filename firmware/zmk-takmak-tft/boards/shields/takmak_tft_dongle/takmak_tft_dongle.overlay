#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/nrf-pinctrl.h>
/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,matrix-transform = &default_transform;
        zephyr,display = &tft;
    };
    /delete-node/ EXT_POWER;
    mock_kscan: kscan0 {
        compatible = "zmk,kscan-mock";
        columns = <15>;
        rows = <5>;
        events = <>;
    };
    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>;
        b-gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>;
        steps = <80>;
        status = "disabled";
    };
    right_encoder: encoder_right {
        compatible = "alps,ec11";
        a-gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>;
        b-gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>;
        steps = <80>;
        status = "disabled";
    };
    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
        triggers-per-rotation = <10>;
    };
	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <15>;
		rows = <5>;
		map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6)  RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6)  RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)  RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6)  RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13) RC(3,14)
RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4)         RC(4,6)  RC(4,7)         RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13) RC(4,14)
		>;
	};
};
// Hold SuperMini external LDO enabled; no persisted external-power setting.
&gpio0 {
    tft_power_enable {
        gpio-hog;
        gpios = <13 GPIO_ACTIVE_HIGH>;
        output-high;
    };
};
&i2c0 { status = "disabled"; };
&uart0 { status = "disabled"; };
&spi1 { status = "disabled"; };
&pinctrl {
    tft_spi_default: tft_spi_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>, <NRF_PSEL(SPIM_MOSI, 0, 10)>;
        };
    };
    tft_spi_sleep: tft_spi_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>, <NRF_PSEL(SPIM_MOSI, 0, 10)>;
            low-power-enable;
        };
    };
};
&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&tft_spi_default>;
    pinctrl-1 = <&tft_spi_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;
    tft: st7789v@0 {
        compatible = "sitronix,st7789v";
        reg = <0>;
        spi-max-frequency = <1000000>;
        cmd-data-gpios = <&gpio0 31 GPIO_ACTIVE_LOW>;
        reset-gpios = <&gpio0 29 GPIO_ACTIVE_LOW>;
        // Landscape window: portrait 76x284 (82,18), axes swapped.
        width = <284>;
        height = <76>;
        x-offset = <18>;
        y-offset = <82>;
        mdac = <0x60>;
        colmod = <0x55>;
        ready-time-ms = <200>;
        vcom = <0x20>;
        gctrl = <0x35>;
        lcm = <0x2c>;
        gamma = <0x01>;
        porch-param = [0c 0c 00 33 33];
        cmd2en-param = [5a 69 02 01];
        pwctrl1-param = [a4 a1];
        pvgam-param = [d0 04 0d 11 13 2b 3f 54 4c 18 0d 0b 1f 23];
        nvgam-param = [d0 04 0c 11 13 2c 3f 44 51 2f 1f 1f 20 23];
        ram-param = [00 f0];
        rgb-param = [cd 08 14];
    };
};
